# Copy to backend/.env (the backend loads it automatically) and to mobile/.env for the app.
DATABASE_URL=postgresql+psycopg://localhost/smart_grocery
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Abandoned checkouts (pending payment) release their stock after this many minutes
RESERVATION_TTL_MINUTES=10
# Simulated fulfilment: seconds each order stays in a stage before advancing
SIM_STEP_SECONDS=20
# Background ticker that expires reservations and advances simulated fulfilment
ENABLE_BACKGROUND_TICKER=true
# Attempt real Expo push delivery (fails gracefully when offline)
EXPO_PUSH_ENABLED=true
CORS_ORIGINS=*
